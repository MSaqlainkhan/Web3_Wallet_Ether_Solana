{
  "name": "aetheris-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm --filter common build && pnpm --filter server build && pnpm --filter web build",
    "test": "pnpm --filter common test && pnpm --filter web test",
    "lint": "pnpm --filter \"*\" lint",
    "typecheck": "pnpm --filter @aetheris/common build && pnpm --filter \"*\" typecheck"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "bufferutil",
      "utf-8-validate"
    ]
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}

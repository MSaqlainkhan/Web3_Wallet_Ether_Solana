# ==============================================================================
# AETHERIS WALLET - ENVIRONMENT CONFIGURATION
# ==============================================================================

# NEXT.JS FRONTEND (apps/web)
NEXT_PUBLIC_APP_NAME="Aetheris Wallet"
NEXT_PUBLIC_DEFAULT_NETWORK="ethereum-sepolia"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# EVM RPC ENDPOINTS (Defaults to public testnet endpoints)
NEXT_PUBLIC_SEPOLIA_RPC_URL="https://rpc.sepolia.org"
NEXT_PUBLIC_MAINNET_RPC_URL="https://eth.llamarpc.com"
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"

# SOLANA RPC ENDPOINTS
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL="https://api.devnet.solana.com"
NEXT_PUBLIC_SOLANA_MAINNET_RPC_URL="https://api.mainnet-beta.solana.com"

# DEX AGGREGATOR API KEYS (Optional for sandbox/testnet; required for high rate-limit production)
ZEROX_API_KEY=""
ONEINCH_API_KEY=""
JUPITER_API_KEY=""

# FIAT ON/OFF-RAMP LICENSED PROVIDERS (Sandbox mode enabled by default)
NEXT_PUBLIC_MOONPAY_API_KEY=""
NEXT_PUBLIC_TRANSAK_API_KEY=""

# AUXILIARY BACKEND SERVER (apps/server)
PORT=4000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"
REDIS_URL="redis://localhost:6379"

# ZK OIDC PROVING SERVICE (Phase 5)
GOOGLE_CLIENT_ID=""
ZK_SALT_SERVICE_URL=""
